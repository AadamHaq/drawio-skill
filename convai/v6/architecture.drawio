        </mxCell>
        <mxCell id="vpe-stt-turn" parent="vp-worker" edge="1" source="vp-stt" target="vp-turn"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vpe-turn-guard" parent="vp-worker" edge="1" source="vp-turn" target="vp-guard-in"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vpe-guard-llm" parent="vp-worker" edge="1" source="vp-guard-in" target="vp-llm"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vpe-llm-guardout" parent="vp-worker" edge="1" source="vp-llm" target="vp-guard-out"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vpe-guardout-tts" parent="vp-worker" edge="1" source="vp-guard-out" target="vp-tts"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API (external call from worker) -->
        <mxCell id="vp-api-box" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;"
          value="API Service&lt;br&gt;Tool execution (transactions, accounts)">
          <mxGeometry x="314" y="870" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Client ↔ LiveKit -->
        <mxCell id="vpe-client-lk" parent="1" edge="1" source="vp-client" target="vp-livekit"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;dashPattern=12 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          value="WebRTC">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LiveKit → Worker -->
        <mxCell id="vpe-lk-worker" parent="1" edge="1" source="vp-livekit" target="vp-worker"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;dashPattern=12 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          value="audio frames">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Worker → API -->
        <mxCell id="vpe-worker-api" parent="1" edge="1" source="vp-worker" target="vp-api-box"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          value="tool results">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

