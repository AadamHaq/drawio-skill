          <mxGeometry x="140" y="20" width="546" height="30" as="geometry" />
        </mxCell>

        <!-- Web Client -->
        <mxCell id="vp-client" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;"
          value="Web Client&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;LiveKit Client SDK · WebRTC&lt;/font&gt;">
          <mxGeometry x="314" y="70" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- LiveKit SFU -->
        <mxCell id="vp-livekit" parent="1" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;"
          value="LiveKit SFU&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;WebRTC signaling + media relay :7880&lt;/font&gt;">
          <mxGeometry x="314" y="170" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Realtime-Voice Worker -->
        <mxCell id="vp-worker" parent="1" vertex="1"
          style="swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;html=1;rounded=1;"
          value="Realtime-Voice Worker">
          <mxGeometry x="214" y="280" width="400" height="540" as="geometry" />
        </mxCell>

        <!-- VAD -->
        <mxCell id="vp-vad" parent="vp-worker" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=11;"
          value="NeMo MarbleNet VAD&lt;br&gt;confidence: 0.5 · start: 0.2s · stop: 0.7s">
          <mxGeometry x="18" y="45" width="364" height="50" as="geometry" />
        </mxCell>

        <!-- STT -->
        <mxCell id="vp-stt" parent="vp-worker" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=11;"
          value="STT (Triton gRPC)&lt;br&gt;model: nemotron_asr · chunk: 80ms&lt;br&gt;streaming sequence batch">
          <mxGeometry x="18" y="111" width="364" height="58" as="geometry" />
        </mxCell>

        <!-- SmartTurn -->
        <mxCell id="vp-turn" parent="vp-worker" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=11;"
          value="SmartTurn v3&lt;br&gt;silence fallback: 1.5s · timeout: 2.0s">
          <mxGeometry x="18" y="185" width="364" height="50" as="geometry" />
        </mxCell>

        <!-- Guardrails (input) -->
        <mxCell id="vp-guard-in" parent="vp-worker" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=11;"
          value="Input Guardrails&lt;br&gt;language · prompt_injection · multi_guard">
          <mxGeometry x="18" y="251" width="364" height="50" as="geometry" />
        </mxCell>

        <!-- LLM -->
        <mxCell id="vp-llm" parent="vp-worker" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=11;"
          value="LLM (vLLM OpenAI /v1)&lt;br&gt;model: gemma-4-26B-A4B-it&lt;br&gt;tool calling · conversation context">
          <mxGeometry x="18" y="317" width="364" height="58" as="geometry" />
        </mxCell>

        <!-- Guardrails (output) -->
        <mxCell id="vp-guard-out" parent="vp-worker" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=11;"
          value="Output Guardrails&lt;br&gt;multi_guard (fail-closed)">
          <mxGeometry x="18" y="391" width="364" height="50" as="geometry" />
        </mxCell>

        <!-- TTS -->
        <mxCell id="vp-tts" parent="vp-worker" vertex="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=11;"
          value="TTS (Triton gRPC)&lt;br&gt;model: chatterbox_tts · decoupled streaming&lt;br&gt;soft split: 100 chars · max: 150 chars">
          <mxGeometry x="18" y="457" width="364" height="58" as="geometry" />
        </mxCell>

        <!-- Edges inside worker swimlane -->
        <mxCell id="vpe-vad-stt" parent="vp-worker" edge="1" source="vp-vad" target="vp-stt"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          value="">
