<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="ac.draw.io">
  <diagram id="page-0" name="Architecture Overview">
    <mxGraphModel pageWidth="960" pageHeight="840" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══════════ Layer 0: Config (top) ═══════════ -->
        <mxCell id="L0" value="Config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="900" height="100" as="geometry" />
        </mxCell>

        <!-- Config items (root-level siblings) -->
        <mxCell id="setups" value="setups/&lt;br/&gt;&lt;font style='font-size:9px'&gt;one JSON per cell, pairs&lt;br/&gt;prompt arm + environment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="195" y="60" width="240" height="58" as="geometry" />
        </mxCell>

        <mxCell id="eval_params" value="eval_params.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;named eval sets (lab_prompts,&lt;br/&gt;suite_full, harvest_tool_200)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="525" y="60" width="240" height="58" as="geometry" />
        </mxCell>

        <!-- ═══════════ Layer 1: Orchestration ═══════════ -->
        <mxCell id="L1" value="Orchestration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="30" y="180" width="900" height="120" as="geometry" />
        </mxCell>

        <!-- Orchestration items (root-level siblings) -->
        <mxCell id="sweep" value="sweep.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;eval-params × cells matrix,&lt;br/&gt;keep-going, prints ceval_table&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="224" width="240" height="58" as="geometry" />
        </mxCell>

        <mxCell id="run_ceval" value="run_ceval.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;boots realtime per cell,&lt;br/&gt;invokes ceval, tears down&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="224" width="240" height="58" as="geometry" />
        </mxCell>

        <mxCell id="models" value="models.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;named LLM targets (sim+judge),&lt;br/&gt;resolves from pipeline.env&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="224" width="240" height="58" as="geometry" />
        </mxCell>

        <!-- ═══════════ Layer 2: Frozen Assets ═══════════ -->
        <mxCell id="L2" value="Frozen Assets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="30" y="360" width="900" height="120" as="geometry" />
        </mxCell>

        <!-- Frozen Assets items (root-level siblings) -->
        <mxCell id="envs" value="environments/&lt;br/&gt;&lt;font style='font-size:9px'&gt;15 frozen tool arms (e0–e14),&lt;br/&gt;registry.py resolves by name&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="404" width="240" height="58" as="geometry" />
        </mxCell>

        <mxCell id="prompts" value="prompt_arms/&lt;br/&gt;&lt;font style='font-size:9px'&gt;frozen prompts p0–p11,&lt;br/&gt;sections/ compose sys prompt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="404" width="240" height="58" as="geometry" />
        </mxCell>

        <mxCell id="datasets" value="datasets/&lt;br/&gt;&lt;font style='font-size:9px'&gt;lab prompts + scenario&lt;br/&gt;batteries (57 labelled)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="404" width="240" height="58" as="geometry" />
        </mxCell>

        <!-- ═══════════ Layer 3: Product Under Test + View ═══════════ -->
        <mxCell id="L3" value="Product + Readers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="30" y="540" width="900" height="110" as="geometry" />
        </mxCell>

        <!-- Product items (root-level siblings) -->
        <mxCell id="convai" value="convai/ submodule&lt;br/&gt;&lt;font style='font-size:9px'&gt;pinned product SHA, realtime&lt;br/&gt;service + API under test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="195" y="584" width="240" height="58" as="geometry" />
        </mxCell>

        <mxCell id="view" value="view/&lt;br/&gt;&lt;font style='font-size:9px'&gt;inspector.py, ceval_table.py,&lt;br/&gt;React app for chart render&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="525" y="584" width="240" height="58" as="geometry" />
        </mxCell>

        <!-- ═══════════ Edges ═══════════ -->

        <!-- Config → Orchestration -->
        <mxCell id="e-setup-sweep" edge="1" source="setups" target="sweep" value="cell list"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" parent="1">
