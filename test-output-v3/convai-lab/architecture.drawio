        <!-- Orchestration internal: sweep → run_ceval -->
        <mxCell id="e-sweep-runceval" edge="1" source="sweep" target="run_ceval" value="per cell"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Orchestration internal: models → run_ceval -->
        <mxCell id="e-models-runceval" edge="1" source="models" target="run_ceval" value="sim+judge"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Orchestration → Frozen Assets -->
        <mxCell id="e-runceval-envs" edge="1" source="run_ceval" target="envs" value="loads arm"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1">
          <mxGeometry relative="1" as="geometry">
