        <mxCell id="guard-ext" value="Guardrails&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Input / Output Rails&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="290" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- ═══════════ CROSS-SERVICE EDGES ═══════════ -->
        <!-- f1: LiveKit → Receive audio -->
        <mxCell id="f1" value="audio in" edge="1" source="lk-ext" target="p-receive" parent="1"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;dashPattern=12 4;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
