        <mxCell id="stt-ext" value="STT (Triton)&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Nemotron ASR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="510" y="210" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="llm-ext" value="LLM (vLLM)&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Qwen3-8B / Gemma-4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="510" y="300" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tts-ext" value="TTS (Triton)&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Chatterbox / Kokoro&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="510" y="390" width="140" height="50" as="geometry" />
