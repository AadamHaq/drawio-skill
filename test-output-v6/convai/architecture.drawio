        <!-- f6: LLM step → Guardrails (guard check) -->
        <mxCell id="f6" value="guard check" edge="1" source="p-llm" target="guard-ext" parent="1"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=3;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
