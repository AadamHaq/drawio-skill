          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- f5: Send → LiveKit (audio out) - route LEFT avoiding guard-ext -->
        <mxCell id="f5" value="audio out" edge="1" source="p-send" target="lk-ext" parent="1"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;dashPattern=12 4;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
