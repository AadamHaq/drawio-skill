        <!-- ═══════════ EXTERNAL DEPENDENCIES ═══════════ -->
        <mxCell id="lk-ext" value="LiveKit SFU&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;WebRTC :7880&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="140" height="50" as="geometry" />
