              <mxPoint x="1160" y="700" />
              <mxPoint x="820" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- e12: web → livekit (WebRTC/WS) — route far right past TTS -->
        <mxCell id="e12" edge="1" source="web" target="livekit" value="WebRTC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;dashPattern=12 4;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" parent="1">
