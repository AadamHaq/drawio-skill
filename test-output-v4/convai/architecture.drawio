  <diagram id="data-flow" name="Voice Pipeline">
    <mxGraphModel pageWidth="827" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Swimlane: Realtime-Voice Pipeline -->
        <mxCell id="voice-sl" value="Realtime-Voice Pipeline&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pipecat audio processing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="290" y="60" width="240" height="510" as="geometry" />
        </mxCell>
        <mxCell id="v-step1" value="LiveKit Transport&lt;br/&gt;receive audio frames" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="voice-sl">
          <mxGeometry x="18" y="56" width="204" height="58" as="geometry" />
        </mxCell>
        <mxCell id="v-step2" value="STT Processor&lt;br/&gt;transcribe to text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="voice-sl">
          <mxGeometry x="18" y="144" width="204" height="58" as="geometry" />
        </mxCell>
        <mxCell id="v-step3" value="Guardrails Check&lt;br/&gt;input safety screening" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="voice-sl">
          <mxGeometry x="18" y="232" width="204" height="58" as="geometry" />
        </mxCell>
        <mxCell id="v-step4" value="LLM Completion&lt;br/&gt;stream response tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="voice-sl">
          <mxGeometry x="18" y="320" width="204" height="58" as="geometry" />
        </mxCell>
        <mxCell id="v-step5" value="TTS Synthesis&lt;br/&gt;generate audio output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="voice-sl">
          <mxGeometry x="18" y="408" width="204" height="58" as="geometry" />
        </mxCell>

        <!-- External dependencies -->
        <mxCell id="ext-lk" value="LiveKit Server&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;WebRTC signalling&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="97" width="150" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ext-stt" value="STT (Triton)&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;nemotron_asr model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="185" width="150" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ext-guard" value="Guardrails (Triton)&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;4 safety models&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="273" width="150" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ext-llm" value="LLM (vLLM)&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Qwen3-8B / Gemma-4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="361" width="150" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ext-tts" value="TTS (Triton)&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;chatterbox_tts model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="449" width="150" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ext-api" value="Concierge API&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tool execution, DB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="361" width="150" height="44" as="geometry" />
        </mxCell>

        <!-- Sequential edges (within swimlane) -->
        <mxCell id="ve1" edge="1" source="v-step1" target="v-step2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="voice-sl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ve2" edge="1" source="v-step2" target="v-step3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="voice-sl">
