        </mxCell>
        <mxCell id="redis" value="Redis&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Sessions + rate limiting&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;" vertex="1" parent="1">
