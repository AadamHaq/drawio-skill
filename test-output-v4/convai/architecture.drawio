          <mxGeometry x="10" y="84" width="180" height="24" as="geometry" />
        </mxCell>

        <mxCell id="guardrails" value="Guardrails&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Safety inference server&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=30;" vertex="1" parent="1">
