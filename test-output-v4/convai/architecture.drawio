        <mxCell id="livekit" value="LiveKit&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;WebRTC media server&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="750" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- ═══ EDGES ═══ -->
        <!-- e1: web → api (HTTP) — route left side avoiding middle services -->
        <mxCell id="e1" edge="1" source="web" target="api" value="REST /api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="510" y="200" />
              <mxPoint x="260" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- e2: web → rt-text (WebSocket) — straight down -->
        <mxCell id="e2" edge="1" source="web" target="rt-text" value="WebSocket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;dashPattern=12 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1">
          <mxGeometry relative="1" as="geometry" />
