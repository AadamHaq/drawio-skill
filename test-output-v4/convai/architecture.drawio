          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- e4: rt-voice → llm (HTTP) — route under services, avoid stt box -->
        <mxCell id="e4" edge="1" source="rt-voice" target="llm" value="completions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="720" y="450" />
              <mxPoint x="300" y="450" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- e5: rt-voice → stt (gRPC) — straight down -->
        <mxCell id="e5" edge="1" source="rt-voice" target="stt" value="gRPC infer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- e6: rt-voice → tts (gRPC) — route right -->
        <mxCell id="e6" edge="1" source="rt-voice" target="tts" value="gRPC synth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=3;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="840" y="450" />
              <mxPoint x="1040" y="450" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- e7: rt-text → llm (HTTP) — route left, below row 2 -->
        <mxCell id="e7" edge="1" source="rt-text" target="llm" value="text comp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="460" y="470" />
              <mxPoint x="220" y="470" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- e8: rt-text → guardrails (gRPC) — route down to guardrails -->
        <mxCell id="e8" edge="1" source="rt-text" target="guardrails" value="gRPC guard" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=3;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="430" />
              <mxPoint x="520" y="430" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- e9: api → postgres (database) — route left side, avoid llm box -->
        <mxCell id="e9" edge="1" source="api" target="postgres" value="queries" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;dashPattern=8 4;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="420" />
              <mxPoint x="100" y="420" />
              <mxPoint x="100" y="700" />
              <mxPoint x="280" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- e10: api → redis (database) — route right side, avoid overlap with e7 -->
        <mxCell id="e10" edge="1" source="api" target="redis" value="sessions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;dashPattern=8 4;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1">
