        <mxCell id="prod-view" value="view/&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;inspector.py, ceval_table.py,&lt;br/&gt;React webapp: read results&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="485" y="624" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- ═══ EDGES ═══ -->

