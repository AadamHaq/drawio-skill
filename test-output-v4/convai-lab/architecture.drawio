<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="ac.draw.io">
  <diagram id="page-0" name="Architecture Overview">
    <mxGraphModel pageWidth="960" pageHeight="810" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══ Layer 0: Config ═══ -->
        <mxCell id="L0" value="Config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="860" height="120" as="geometry" />
        </mxCell>

        <!-- Config items (root-level siblings for cross-band edge targets) -->
        <mxCell id="cfg-setups" value="setups/*.json&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;cell config: prompt arm +&lt;br/&gt;env + think flag per cell&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="84" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="cfg-prompts" value="prompt_arms/p0–p11&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;frozen system-prompt snapshots&lt;br/&gt;composed from sections/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="84" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="cfg-models" value="models.py&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;LLM targets: local vLLM,&lt;br/&gt;GenAI Gateway, inherit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="84" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- ═══ Layer 1: Orchestration ═══ -->
        <mxCell id="L1" value="Orchestration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="30" y="210" width="860" height="120" as="geometry" />
        </mxCell>

        <!-- Orchestration items (root-level siblings) -->
        <mxCell id="orch-sweep" value="sweep.py&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;eval_params × cells matrix,&lt;br/&gt;one launcher per pairing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="195" y="264" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="orch-runceval" value="run_ceval.py&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;single-run launcher: boot&lt;br/&gt;realtime, invoke ceval, teardown&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="485" y="264" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- ═══ Layer 2: Environment ═══ -->
        <mxCell id="L2" value="Environment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="30" y="390" width="860" height="120" as="geometry" />
        </mxCell>

        <!-- Environment items (root-level siblings) -->
        <mxCell id="env-registry" value="registry.py&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;resolve env name → load&lt;br/&gt;frozen ToolSpec + logic.py&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="444" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="env-arms" value="environments/e0–e15&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;frozen tool arms: tools.py,&lt;br/&gt;logic.py, manifest.py per env&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="444" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="env-datasets" value="datasets/&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;prompts + scenarios:&lt;br/&gt;lab_prompts, harvest_tool_200&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="444" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- ═══ Layer 3: Product & View ═══ -->
        <mxCell id="L3" value="Product &amp; View" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="30" y="570" width="860" height="120" as="geometry" />
        </mxCell>

        <!-- Product items (root-level siblings) -->
        <mxCell id="prod-convai" value="convai/ (submodule)&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;the product: realtime service,&lt;br/&gt;api, pinned SHA under test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="195" y="624" width="240" height="60" as="geometry" />
