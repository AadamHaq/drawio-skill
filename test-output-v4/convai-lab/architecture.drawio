        <!-- e3: orch-sweep → orch-runceval (per pairing) - horizontal within band -->
        <mxCell id="e3" edge="1" source="orch-sweep" target="orch-runceval" value="per pairing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1">
          <mxGeometry relative="1" as="geometry" />
