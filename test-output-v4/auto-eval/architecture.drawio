<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="ac.draw.io">
  <diagram id="overview" name="Architecture Overview">
    <mxGraphModel pageWidth="960" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══ Layer 0: Config ═══ -->
        <mxCell id="L0" value="Config" style="swimlane;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="860" height="80" as="geometry" />
        </mxCell>

        <!-- Config item (root-level sibling, visually inside L0) -->
        <mxCell id="cfg" value="generation_plan_*.yaml&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;env, models, taxonomy, pipeline stages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="58" width="240" height="52" as="geometry" />
        </mxCell>

        <!-- ═══ Layer 1: Pipeline ═══ -->
