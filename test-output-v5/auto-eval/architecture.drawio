          <mxGeometry x="350" y="30" width="170" height="58" as="geometry" />
        </mxCell>

        <!-- ═══ GENERATOR SWIMLANE (y=148, h=488) ═══ -->
        <mxCell id="sl-gen" value="Generator&lt;br/&gt;multi-turn block pool builder" style="swimlane;startSize=48;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;html=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="148" width="240" height="488" as="geometry" />
