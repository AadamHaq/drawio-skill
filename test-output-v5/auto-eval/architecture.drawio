        <mxCell id="gen-combo" value="Combo Grid Builder&lt;br/&gt;dialect × type × topic&lt;br/&gt;× emotion × style" style="rounded=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;html=1;whiteSpace=wrap;" vertex="1" parent="sl-gen">
          <mxGeometry x="18" y="74" width="204" height="76" as="geometry" />
        </mxCell>
        <mxCell id="gen-query" value="Query Generation (Stage 1)&lt;br/&gt;deepseek-v4-flash / temp=0.7&lt;br/&gt;persona + topic → user msg" style="rounded=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;html=1;whiteSpace=wrap;" vertex="1" parent="sl-gen">
          <mxGeometry x="18" y="180" width="204" height="76" as="geometry" />
        </mxCell>
        <mxCell id="gen-answer" value="Answer Decision (Stage 2)&lt;br/&gt;deepseek-v4-flash / auto&lt;br/&gt;dispatch by ToolBehavior" style="rounded=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;html=1;whiteSpace=wrap;" vertex="1" parent="sl-gen">
          <mxGeometry x="18" y="286" width="204" height="76" as="geometry" />
        </mxCell>
        <mxCell id="gen-tool" value="Tool Result + Response (Stage 3)&lt;br/&gt;EXECUTE: real DB via Postgres&lt;br/&gt;SYNTHESIZE / DETERMINISTIC" style="rounded=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;html=1;whiteSpace=wrap;" vertex="1" parent="sl-gen">
