        <mxCell id="e-gen-1" edge="1" source="gen-combo" target="gen-query" parent="sl-gen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="">
