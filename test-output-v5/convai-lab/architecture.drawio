          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="171" />
              <mxPoint x="228" y="171" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- promptarms → runceval (angled, waypoint in gap) -->
        <mxCell id="e-promptarms-runceval" edge="1" source="promptarms" target="runceval" value=""
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="732" y="171" />
              <mxPoint x="540" y="171" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Runners internal: sweep → runceval (horizontal, same band) -->
        <mxCell id="e-sweep-runceval" edge="1" source="sweep" target="runceval" value=""
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Runners → View (cross-band, green) -->
        <!-- sweep → cevaltable (angled) -->
        <mxCell id="e-sweep-cevaltable" edge="1" source="sweep" target="cevaltable" value="print_table()"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelPosition=right;align=left;" parent="1">
