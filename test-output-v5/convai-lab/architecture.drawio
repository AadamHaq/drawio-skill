          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="432" y="540" />
              <mxPoint x="272" y="540" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- promptrunner → registry -->
        <mxCell id="e-promptrunner-registry" edge="1" source="promptrunner" target="registry" value="resolve()"
