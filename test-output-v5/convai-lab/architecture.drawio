<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="ac.draw.io">
  <diagram id="page-0" name="Architecture Overview">
    <mxGraphModel pageWidth="960" pageHeight="870" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══ Layer 0: Config / Input ═══ -->
        <mxCell id="L0" value="Config / Input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="900" height="124" as="geometry" />
        </mxCell>

        <!-- Config items (root-level siblings for cross-layer edge targets) -->
        <mxCell id="setups" value="setups/&lt;br/&gt;&lt;font style='font-size:9px'&gt;one JSON per cell pairing&lt;br/&gt;prompt_pN_env_eN[_think].json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="48" y="84" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="evalparams" value="eval_params.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;named parameter sets: battery,&lt;br/&gt;depth, persona store per eval&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="84" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="promptarms" value="prompt_arms/ (p0–p11)&lt;br/&gt;&lt;font style='font-size:9px'&gt;frozen system prompt snapshots,&lt;br/&gt;composed from sections/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="672" y="84" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- ═══ Layer 1: Runners ═══ -->
        <mxCell id="L1" value="Runners (Experiment Drivers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="30" y="204" width="900" height="124" as="geometry" />
        </mxCell>

        <!-- Runner items (root-level siblings) -->
        <mxCell id="sweep" value="sweep.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;eval_params × cells matrix driver,&lt;br/&gt;sequential cell execution&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="48" y="258" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="runceval" value="run_ceval.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;boots realtime per cell, invokes&lt;br/&gt;ceval, records provenance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="258" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="promptrunner" value="prompt_runner.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;legacy single-cell driver,&lt;br/&gt;manages realtime subprocess&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="672" y="258" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- ═══ Layer 2: View ═══ -->
        <mxCell id="L2" value="View (Result Readers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="30" y="378" width="900" height="124" as="geometry" />
        </mxCell>

        <!-- View items (root-level siblings) -->
        <mxCell id="inspector" value="inspector.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;terminal result viewer, runs&lt;br/&gt;side-by-side with alignment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="48" y="432" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="cevaltable" value="ceval_table.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;metric vector per cell, printed&lt;br/&gt;by sweep between pairings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="432" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="webapp" value="view/app (React/Vite)&lt;br/&gt;&lt;font style='font-size:9px'&gt;web viewer with real product&lt;br/&gt;chart components, side-by-side&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="672" y="432" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- ═══ Layer 3: Environments ═══ -->
        <mxCell id="L3" value="Environments (Frozen Tool Protocol)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef5f5;strokeColor=#b85450;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="30" y="577" width="900" height="124" as="geometry" />
        </mxCell>

        <!-- Environment items (root-level siblings) -->
        <mxCell id="registry" value="registry.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;resolves env name → loads frozen&lt;br/&gt;ToolSpec + logic + manifest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="631" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="frozenarms" value="frozen arms (e0–e15)&lt;br/&gt;&lt;font style='font-size:9px'&gt;15 tool snapshots: schemas,&lt;br/&gt;logic, manifest per arm&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="631" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- ═══ EDGES ═══ -->

        <!-- Config → Runners (cross-band, blue, no label) -->
        <!-- setups → sweep (vertical, aligned) -->
        <mxCell id="e-setups-sweep" edge="1" source="setups" target="sweep" value=""
