        <!-- ═══ External: convai/ submodule note ═══ -->
        <mxCell id="convai-note" value="convai/ (pinned submodule)&lt;br/&gt;&lt;font style='font-size:9px'&gt;the product under test — lab&lt;br/&gt;consumes it, never imports from lab&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;fontSize=11;dashed=1;dashPattern=8 4;"
