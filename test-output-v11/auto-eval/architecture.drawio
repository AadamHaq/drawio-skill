  <diagram id="page-1" name="Generation Detail">
    <mxGraphModel pageWidth="900" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══ Generator swimlane ═══ -->
        <mxCell id="sl-gen" value="Generator&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;multi_turn_gen.py + answer_gen.py&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=46;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="510" height="446" as="geometry" />
        </mxCell>

        <!-- Steps inside swimlane (children) -->
        <mxCell id="s1" value="&lt;b&gt;1. Combo Grid&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;combos.py — Cartesian: dialect × block_type × topic × emotion × style&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=10;" vertex="1" parent="sl-gen">
          <mxGeometry x="18" y="72" width="464" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="&lt;b&gt;2. Query Generation&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;query model (DeepSeek-V4-Flash, temp=0.7) — realistic user message per combo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=10;" vertex="1" parent="sl-gen">
          <mxGeometry x="18" y="148" width="464" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="&lt;b&gt;3. Answer Decision&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;answer model (temp=0.3, tool_choice=auto)&lt;br/&gt;→ tool call, NLR, capture_response, or guardrail&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=10;" vertex="1" parent="sl-gen">
          <mxGeometry x="18" y="224" width="464" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="&lt;b&gt;4. Tool Behavior Dispatch&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;EXECUTE→env.execute_tool() | SYNTHESIZE→LLM | DETERMINISTIC→env | TERMINAL→done&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=10;" vertex="1" parent="sl-gen">
          <mxGeometry x="18" y="300" width="464" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="&lt;b&gt;5. Fix + Re-score&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;fixer.py — LLM rewrite of failed turns (temp=0.3)&lt;br/&gt;re-annotate via ensemble or single scorer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=10;" vertex="1" parent="sl-gen">
          <mxGeometry x="18" y="376" width="464" height="50" as="geometry" />
        </mxCell>

        <!-- Sequential arrows inside swimlane -->
        <mxCell id="es1-2" edge="1" source="s1" target="s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="sl-gen">
