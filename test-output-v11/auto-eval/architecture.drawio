        <!-- Config item (root-level sibling) -->
        <mxCell id="cfg" value="&lt;b&gt;generation_plan_ric_v9.yaml&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;environment, models, taxonomy, thresholds, output paths&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="425" y="86" width="340" height="44" as="geometry" />
        </mxCell>

        <!-- ═══ Pipeline Layer (band) ═══ -->
