          <mxGeometry x="30" y="190" width="1150" height="150" as="geometry" />
        </mxCell>

        <!-- Pipeline items (root-level siblings for edge clarity) -->
        <mxCell id="gen" value="&lt;b&gt;Generator&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;combo grid → query → answer → tool dispatch&lt;br/&gt;DeepSeek-V4-Flash, temp 0.3/0.7&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="75" y="246" width="270" height="70" as="geometry" />
        </mxCell>

        <mxCell id="val" value="&lt;b&gt;Validator&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;LLM scorer (rubric-driven), mean≥8 pass gate&lt;br/&gt;fix failed → re-score loop&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="445" y="246" width="270" height="70" as="geometry" />
        </mxCell>

        <mxCell id="post" value="&lt;b&gt;Post-Processing&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;assemble blocks → split (train/val/eval)&lt;br/&gt;rebalance tool:text ratio + analysis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="815" y="246" width="270" height="70" as="geometry" />
        </mxCell>

        <!-- ═══ Environment Layer (band, dashed) ═══ -->
        <mxCell id="L2" value="Environment (pluggable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef5f5;strokeColor=#b85450;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=30;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="30" y="410" width="1150" height="140" as="geometry" />
        </mxCell>

        <!-- Environment items (root-level siblings) -->
        <mxCell id="env-tools" value="&lt;b&gt;ToolSpec Registry&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;get_tools() → ToolBehavior enum&lt;br/&gt;EXECUTE | SYNTHESIZE | DETERM | TERMINAL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
