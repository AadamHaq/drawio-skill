<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="ac.draw.io">
  <diagram id="overview" name="Pipeline Overview">
    <mxGraphModel pageWidth="910" pageHeight="2040" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══ INPUT NODES (y=30) ═══ -->
        <mxCell id="input-envs" value="Environments&lt;br/&gt;&lt;font point-size='10'&gt;e0–e16, visualise_data_v1/v2&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="113" y="30" width="180" height="58" as="geometry" />
        </mxCell>
        <mxCell id="input-prompts" value="Prompt Arms&lt;br/&gt;&lt;font point-size='10'&gt;p0–p12 + sections/&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="333" y="30" width="180" height="58" as="geometry" />
        </mxCell>
        <mxCell id="input-datasets" value="Datasets&lt;br/&gt;&lt;font point-size='10'&gt;corpora/ · scenarios/&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="553" y="30" width="180" height="58" as="geometry" />
        </mxCell>

        <!-- ═══ STAGE 1: AUTHOR (y=148) ═══ -->
        <mxCell id="sl-author" value="1. Author&lt;br/&gt;&lt;font point-size='10'&gt;environments/ · prompt_arms/&lt;/font&gt;" style="swimlane;startSize=46;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;html=1;" vertex="1" parent="1">
          <mxGeometry x="77" y="148" width="700" height="238" as="geometry" />
        </mxCell>
        <mxCell id="author-step1" value="Copy parent arm → new version&lt;br/&gt;&lt;font point-size='10'&gt;cp -r environments/parent environments/eN+1&lt;/font&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#d79b00;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="sl-author">
          <mxGeometry x="18" y="72" width="664" height="58" as="geometry" />
        </mxCell>
        <mxCell id="author-step2" value="Create setup JSON pairing prompt + env&lt;br/&gt;&lt;font point-size='10'&gt;runners/setups/experimental_tools/prompt_pN_env_eM.json&lt;/font&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#d79b00;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="sl-author">
          <mxGeometry x="18" y="160" width="664" height="58" as="geometry" />
        </mxCell>

        <!-- ═══ STAGE 2: CHOOSE (y=446) ═══ -->
        <mxCell id="sl-choose" value="2. Choose&lt;br/&gt;&lt;font point-size='10'&gt;datasets/ · runners/eval_params.py&lt;/font&gt;" style="swimlane;startSize=46;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;html=1;" vertex="1" parent="1">
          <mxGeometry x="77" y="446" width="700" height="256" as="geometry" />
        </mxCell>
        <mxCell id="choose-step1" value="Select named eval params&lt;br/&gt;&lt;font point-size='10'&gt;lab_prompts_hard / chart / guardrail / suite_full&lt;/font&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#d79b00;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="sl-choose">
          <mxGeometry x="18" y="72" width="664" height="58" as="geometry" />
        </mxCell>
        <mxCell id="choose-step2" value="Build scenario battery&lt;br/&gt;&lt;font point-size='10'&gt;prompts_to_scenarios.py · harvest_scenarios.py&lt;br/&gt;--max-turns 3 (exchange_limit_controller)&lt;/font&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#d79b00;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="sl-choose">
          <mxGeometry x="18" y="160" width="664" height="76" as="geometry" />
        </mxCell>

        <!-- ═══ STAGE 3: RUN (y=762) ═══ -->
        <mxCell id="sl-run" value="3. Run&lt;br/&gt;&lt;font point-size='10'&gt;runners/sweep.py&lt;/font&gt;" style="swimlane;startSize=46;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;html=1;" vertex="1" parent="1">
          <mxGeometry x="77" y="762" width="700" height="486" as="geometry" />
        </mxCell>
        <mxCell id="run-step1" value="sweep.py — iterate eval_params × cells&lt;br/&gt;&lt;font point-size='10'&gt;sequential cells (shared Postgres + port)&lt;br/&gt;--smoke marks non-citable · keep-going default&lt;/font&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#d79b00;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="sl-run">
          <mxGeometry x="18" y="72" width="664" height="76" as="geometry" />
        </mxCell>
        <mxCell id="run-step2" value="run_ceval.py — boot realtime-text&lt;br/&gt;&lt;font point-size='10'&gt;managed_realtime(cell.env) via uvicorn&lt;br/&gt;EXPERIMENTAL_ENV + SYSTEM_PROMPT_CONFIG&lt;/font&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#d79b00;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="sl-run">
          <mxGeometry x="18" y="178" width="664" height="76" as="geometry" />
        </mxCell>
        <mxCell id="run-step3" value="Invoke convai-eval (ceval simulate + judge)&lt;br/&gt;&lt;font point-size='10'&gt;sim model + judge model (Gemma-4-26B default)&lt;br/&gt;--batch-size 4 concurrent scenarios&lt;/font&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#d79b00;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="sl-run">
          <mxGeometry x="18" y="284" width="664" height="76" as="geometry" />
        </mxCell>
        <mxCell id="run-step4" value="Record provenance manifest.json&lt;br/&gt;&lt;font point-size='10'&gt;lab SHA + product SHA + dirty flags&lt;br/&gt;results/ceval/&amp;lt;run_id&amp;gt;/manifest.json&lt;/font&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#d79b00;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="sl-run">
          <mxGeometry x="18" y="390" width="664" height="76" as="geometry" />
        </mxCell>

        <!-- ═══ STAGE 4: READ (y=1308) ═══ -->
        <mxCell id="sl-read" value="4. Read&lt;br/&gt;&lt;font point-size='10'&gt;view/&lt;/font&gt;" style="swimlane;startSize=46;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;html=1;" vertex="1" parent="1">
          <mxGeometry x="77" y="1308" width="700" height="380" as="geometry" />
        </mxCell>
        <mxCell id="read-step1" value="ceval_table.py — score vector per cell&lt;br/&gt;&lt;font point-size='10'&gt;deterministic auto-fails + LLM rubric + cross-turn&lt;br/&gt;printed between cells during sweep&lt;/font&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#d79b00;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="sl-read">
          <mxGeometry x="18" y="72" width="664" height="76" as="geometry" />
        </mxCell>
        <mxCell id="read-step2" value="ceval_to_responses.py — adapt for viewer&lt;br/&gt;&lt;font point-size='10'&gt;transforms ceval artifacts → responses.json&lt;br/&gt;auto-run after each cell in sweep&lt;/font&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#d79b00;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="sl-read">
          <mxGeometry x="18" y="178" width="664" height="76" as="geometry" />
        </mxCell>
        <mxCell id="read-step3" value="inspector.py + React webapp&lt;br/&gt;&lt;font point-size='10'&gt;terminal side-by-side viewer · view/app/dist/&lt;br/&gt;real chart components from pinned product&lt;/font&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#d79b00;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="sl-read">
          <mxGeometry x="18" y="284" width="664" height="76" as="geometry" />
        </mxCell>

        <!-- ═══ OUTPUT NODES (y=1748) ═══ -->
        <mxCell id="output-results" value="Evidence Outputs&lt;br/&gt;&lt;font point-size='10'&gt;score vectors · responses.json · viewer app&lt;/font&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;html=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="253" y="1748" width="340" height="58" as="geometry" />
