        <mxCell id="L1" value="Pipeline (domain-agnostic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="30" y="207" width="1020" height="479" as="geometry" />
