        <mxCell id="cfg" value="generation_plan_*.yaml&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;selects env, models, taxonomy,&lt;br/&gt;pipeline stages + thresholds&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
