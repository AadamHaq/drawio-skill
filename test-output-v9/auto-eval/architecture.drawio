        <mxCell id="gen-s1" value="Combo Grid Builder&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Cartesian: dialect × type ×&lt;br/&gt;topic × emotion × style&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="gen-sl">
