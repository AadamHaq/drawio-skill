        </mxCell>
        <mxCell id="gen-s2" value="Block Generation Loop&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;opening + 2-3 followups/block&lt;br/&gt;ToolBehavior dispatch per turn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="gen-sl">
