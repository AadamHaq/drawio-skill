        </mxCell>
        <mxCell id="gen-s3" value="Tool Call Correction&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;LLM rewrite of malformed&lt;br/&gt;calls (deepseek-v4-flash)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="gen-sl">
