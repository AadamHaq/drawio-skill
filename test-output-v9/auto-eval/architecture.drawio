        </mxCell>
        <mxCell id="val-s1" value="LLM Scorer&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;rubric-driven judge, mean≥8&lt;br/&gt;gate (hard_fail≤5 veto)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" vertex="1" parent="val-sl">
