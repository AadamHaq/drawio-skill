        <mxCell id="val-s2" value="Fix + Re-annotate&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;LLM rewrite of failed turns,&lt;br/&gt;then re-score to recover&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" vertex="1" parent="val-sl">
