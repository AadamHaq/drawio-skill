<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="ac.draw.io">
  <diagram id="page-0" name="Architecture Overview">
    <mxGraphModel pageWidth="1540" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══ Layer 0: Config ═══ -->
        <mxCell id="L0" value="Config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="1440" height="134" as="geometry" />
        </mxCell>

        <!-- Config items (root-level siblings) -->
        <mxCell id="setups" value="setups/*.json&lt;br/&gt;&lt;font style='font-size:9px'&gt;cell definition: pairs prompt arm + env&lt;br/&gt;one JSON per matrix point&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="84" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="prompts" value="prompt_arms/ (p0–p10)&lt;br/&gt;&lt;font style='font-size:9px'&gt;frozen system prompt snapshots, composed&lt;br/&gt;from section files under sections/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="84" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="envs" value="environments/ (e0–e16)&lt;br/&gt;&lt;font style='font-size:9px'&gt;frozen tool snapshots: tools.py schemas,&lt;br/&gt;logic.py computation, manifest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="84" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- ═══ Layer 1: Pipeline ═══ -->
        <mxCell id="L1" value="Pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="30" y="214" width="1440" height="200" as="geometry" />
        </mxCell>

        <!-- Pipeline items (root-level siblings) -->
        <mxCell id="sweep" value="sweep.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;iterates eval_params × cells matrix,&lt;br/&gt;runs run_ceval per pairing sequentially&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="268" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="runceval" value="run_ceval.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;boots realtime with cell env, invokes&lt;br/&gt;ceval, records provenance + manifest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="268" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="evalparams" value="eval_params.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;named parameter sets: input battery,&lt;br/&gt;depth (--max-turns 3), persona-db path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="268" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="registry" value="registry.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;resolves env name → importlib loads&lt;br/&gt;frozen tools.py + logic.py modules&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="268" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="viewer" value="view/ceval_table.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;reads run metrics, renders score vector&lt;br/&gt;per cell for cross-arm comparison&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1210" y="268" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- ═══ Layer 2: External ═══ -->
        <mxCell id="L2" value="External Services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef5f5;strokeColor=#b85450;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="30" y="489" width="1440" height="134" as="geometry" />
        </mxCell>

        <!-- External items (root-level siblings) -->
        <mxCell id="realtime" value="convai/ realtime service&lt;br/&gt;&lt;font style='font-size:9px'&gt;the product under test: FastAPI + vLLM,&lt;br/&gt;pinned git submodule at exact SHA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="485" y="543" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ceval" value="convai-eval (sibling repo)&lt;br/&gt;&lt;font style='font-size:9px'&gt;evaluator: simulates customer + judges,&lt;br/&gt;runs scenarios against booted service&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="775" y="543" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- ═══ Edges: Config → Pipeline ═══ -->

        <!-- setups → sweep (down-left, enters sweep top) -->
        <mxCell id="e-setups-sweep" edge="1" source="setups" target="sweep" value="cell defs"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="170" y="114" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- setups → runceval (straight down) -->
        <mxCell id="e-setups-runceval" edge="1" source="setups" target="runceval" value="env overrides"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- envs → registry (straight down) -->
        <mxCell id="e-envs-registry" edge="1" source="envs" target="registry" value="frozen arms"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══ Edges: Pipeline internal ═══ -->

        <!-- sweep → runceval (horizontal right, exitY=0.3 to avoid overlap with evalparams→sweep) -->
        <mxCell id="e-sweep-runceval" edge="1" source="sweep" target="runceval" value="per cell"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- evalparams → sweep (backwards/left, routes BELOW runceval to avoid crossing) -->
        <mxCell id="e-evalparams-sweep" edge="1" source="evalparams" target="sweep" value="ceval args"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="610" y="380" />
              <mxPoint x="170" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- runceval → viewer (routes above pipeline items) -->
        <mxCell id="e-runceval-viewer" edge="1" source="runceval" target="viewer" value="run results"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="532" y="252" />
              <mxPoint x="1330" y="252" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ═══ Edges: Pipeline → External ═══ -->

        <!-- runceval → realtime (down, dashed) -->
        <mxCell id="e-runceval-realtime" edge="1" source="runceval" target="realtime" value="boots service"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450;strokeWidth=2;dashed=1;dashPattern=8 4;labelPosition=right;align=left;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="412" y="440" />
              <mxPoint x="557" y="440" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- runceval → ceval (down-right, dashed) -->
        <mxCell id="e-runceval-ceval" edge="1" source="runceval" target="ceval" value="invokes eval"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450;strokeWidth=2;dashed=1;dashPattern=8 4;labelPosition=right;align=left;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="508" y="460" />
              <mxPoint x="895" y="460" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- registry → realtime (down-left, dashed) -->
        <mxCell id="e-registry-realtime" edge="1" source="registry" target="realtime" value="load_tools()"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450;strokeWidth=2;dashed=1;dashPattern=8 4;labelPosition=right;align=left;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1040" y="475" />
              <mxPoint x="653" y="475" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ═══ Legend ═══ -->
        <mxCell id="legend" value="Legend&lt;br/&gt;&lt;font style='font-size:9px'&gt;colour key for edge types in this diagram&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="650" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value="── config flow (solid blue)" style="text;html=1;fontSize=9;fillColor=none;strokeColor=none;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="672" width="190" height="16" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="── data flow (solid green)" style="text;html=1;fontSize=9;fillColor=none;strokeColor=none;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="190" height="16" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value="╌╌ service call (dashed red)" style="text;html=1;fontSize=9;fillColor=none;strokeColor=none;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="708" width="190" height="16" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
