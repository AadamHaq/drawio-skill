        <!-- Legend -->
        <mxCell id="legend" value="━━ &lt;font color=&quot;#6c8ebf&quot;&gt;config flow&lt;/font&gt;&lt;br/&gt;━━ &lt;font color=&quot;#82b366&quot;&gt;data flow&lt;/font&gt;&lt;br/&gt;┄┄ &lt;font color=&quot;#b85450&quot;&gt;product dep&lt;/font&gt;"
