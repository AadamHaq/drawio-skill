          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="175" />
              <mxPoint x="460" y="175" />
              <mxPoint x="460" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- EDGES: Runners horizontal (sibling-to-sibling) -->
        <!-- sweep → runceval (route above evalp) -->
        <mxCell id="e-sweep-runceval" edge="1" source="sweep" target="runceval" value="per cell"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" vertex="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="170" y="252" />
              <mxPoint x="750" y="252" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- evalp → runceval (horizontal data-flow, adjacent) -->
        <mxCell id="e-evalp-runceval" edge="1" source="evalp" target="runceval" value="params"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" vertex="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- EDGES: Runners → View (cross-layer) -->
        <!-- runceval → inspector -->
        <mxCell id="e-runceval-inspector" edge="1" source="runceval" target="inspector" value=""
