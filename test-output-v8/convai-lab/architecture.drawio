<mxfile host="Kiro">
  <diagram id="convai-lab-arch" name="Architecture Overview">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Layer 0: Config / Input -->
        <mxCell id="L0" value="Config / Input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="860" height="134" as="geometry" />
        </mxCell>

        <!-- Layer 0 items (root-level siblings, absolute coords) -->
        <mxCell id="env" value="environments/&lt;br/&gt;&lt;font style='font-size:9px'&gt;frozen tool arms e0-e16, registry.py&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="84" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="prompts" value="prompt_arms/&lt;br/&gt;&lt;font style='font-size:9px'&gt;system prompts p0-p12, sections/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="84" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="datasets" value="datasets/&lt;br/&gt;&lt;font style='font-size:9px'&gt;corpora + scenarios, eval batteries&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="84" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Layer 1: Runners -->
        <mxCell id="L1" value="Runners" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="30" y="214" width="860" height="134" as="geometry" />
        </mxCell>

        <!-- Layer 1 items (root-level siblings) -->
        <mxCell id="sweep" value="sweep.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;eval-params x cells matrix, keep-going&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="268" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="evalp" value="eval_params.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;named batteries: depth, persona, suite&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="268" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="runceval" value="run_ceval.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;boot realtime, invoke ceval, teardown&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="268" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Layer 2: View / Results -->
        <mxCell id="L2" value="View / Results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="30" y="398" width="860" height="134" as="geometry" />
        </mxCell>

        <!-- Layer 2 items (root-level siblings) -->
        <mxCell id="inspector" value="inspector.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;terminal viewer, side-by-side compare&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="452" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="table" value="ceval_table.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;metric vector per cell, score compare&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="452" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="webapp" value="view/app/&lt;br/&gt;&lt;font style='font-size:9px'&gt;React/Vite viewer, real chart render&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="452" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Layer 3: Product (Environment) -->
        <mxCell id="L3" value="Product (Submodule)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef5f5;strokeColor=#b85450;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="30" y="582" width="860" height="129" as="geometry" />
        </mxCell>

        <!-- Layer 3 item (root-level sibling) -->
        <mxCell id="convai" value="convai/ submodule&lt;br/&gt;&lt;font style='font-size:9px'&gt;pinned product SHA, never imports lab&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="636" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- EDGES: Config → Runners (cross-layer, via gap) -->
