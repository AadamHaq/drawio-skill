        <mxCell id="guard-ext" value="Guardrails (Triton)&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;4 models gRPC :9021&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="445" width="160" height="50" as="geometry" />
