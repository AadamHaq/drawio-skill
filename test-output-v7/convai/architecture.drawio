        <mxCell id="llm-ext" value="LLM (vLLM)&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;OpenAI-compat :9000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="245" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tts-ext" value="TTS (Triton)&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Chatterbox gRPC :9201&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="345" width="160" height="50" as="geometry" />
