        <mxCell id="seq2" edge="1" source="step-stt" target="step-llm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="sl-voice">
          <mxGeometry relative="1" as="geometry" />
