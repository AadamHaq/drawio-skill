          <mxGeometry x="40" y="50" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="stt-ext" value="STT (Triton)&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Nemotron gRPC :9101&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
