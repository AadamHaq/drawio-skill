        </mxCell>

        <mxCell id="run_ceval" value="run_ceval.py&lt;br/&gt;&lt;font style='font-size:9px'&gt;boot realtime + ceval per&lt;br/&gt;cell, record provenance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="238" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="prompt_runner" value="prompt_runner.py (legacy)&lt;br/&gt;&lt;font style='font-size:9px'&gt;one cell, manages realtime&lt;br/&gt;subprocess directly&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
