        </mxCell>

        <!-- Layer 2: Assets -->
        <mxCell id="L2" value="Assets (Frozen Snapshots)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="30" y="338" width="860" height="134" as="geometry" />
        </mxCell>

        <!-- Layer 3: View -->
