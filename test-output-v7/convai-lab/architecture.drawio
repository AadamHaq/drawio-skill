<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Kiro">
  <diagram name="Architecture Overview" id="overview">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Layer 0: Config -->
        <mxCell id="L0" value="Config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="860" height="134" as="geometry" />
        </mxCell>

        <!-- Layer 1: Runners -->
        <mxCell id="L1" value="Runners" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=28;" vertex="1" parent="1">
