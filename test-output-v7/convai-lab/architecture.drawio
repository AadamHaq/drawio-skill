        </mxCell>

        <!-- Asset items (root-level siblings) -->
        <mxCell id="environments" value="environments/ (e0-e16)&lt;br/&gt;&lt;font style='font-size:9px'&gt;frozen tool arms: tools.py&lt;br/&gt;+ logic.py + manifest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
