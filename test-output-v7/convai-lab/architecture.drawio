        <!-- Config items (root-level siblings) -->
        <mxCell id="setups" value="setups/*.json&lt;br/&gt;&lt;font style='font-size:9px'&gt;one JSON per cell: prompt arm&lt;br/&gt;+ env + realtime overrides&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
