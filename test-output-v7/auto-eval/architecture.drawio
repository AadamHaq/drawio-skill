        </mxCell>
        <mxCell id="gen-s2" value="Answer Decision&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;tool_choice=auto, temp=0.3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="gen">
