        </mxCell>
        <mxCell id="gen-s3" value="Tool Result + Response&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;dispatch by ToolBehavior enum&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="gen">
