        </mxCell>
        <mxCell id="gen-s4" value="Fix + Re-validate&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;LLM rewrite, re-score loop&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="gen">
          <mxGeometry x="18" y="412" width="204" height="58" as="geometry" />
        </mxCell>

        <!-- ─── Validator Swimlane (root sibling) ─── -->
