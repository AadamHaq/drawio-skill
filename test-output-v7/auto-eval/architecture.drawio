        </mxCell>
        <mxCell id="gen-s1" value="Query Generation&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;deepseek-v4-flash, temp=0.7&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="gen">
