<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="ac.draw.io">
  <diagram id="overview" name="Architecture Overview">
    <mxGraphModel pageWidth="960" pageHeight="1130" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══ Layer 0: Config Band ═══ -->
        <mxCell id="L0" value="Config" style="swimlane;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;html=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="860" height="100" as="geometry" />
        </mxCell>

        <!-- Config item (root sibling for edge targeting) -->
        <mxCell id="cfg" value="generation_plan_*.yaml&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;env, models, taxonomy, pipeline stages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="86" width="240" height="58" as="geometry" />
        </mxCell>

        <!-- ═══ Layer 1: Pipeline Band ═══ -->
        <mxCell id="L1" value="Pipeline" style="swimlane;startSize=28;fillColor=#f0f0f0;strokeColor=#666666;fontStyle=1;fontSize=12;html=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="180" width="860" height="570" as="geometry" />
        </mxCell>

        <!-- ─── Generator Swimlane (root sibling) ─── -->
        <mxCell id="gen" value="Generator&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;run_generation.py&lt;/font&gt;" style="swimlane;startSize=34;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;html=1;rounded=1;" vertex="1" parent="1">
