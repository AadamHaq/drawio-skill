          <mxGeometry x="340" y="234" width="240" height="316" as="geometry" />
        </mxCell>
        <mxCell id="val-s0" value="LLM Scorer&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;rubric-driven judge, mean&amp;gt;=8 gate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="val">
