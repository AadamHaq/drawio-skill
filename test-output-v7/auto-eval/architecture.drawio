        <mxCell id="gen-s0" value="Combo Grid Builder&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;dialect x type x topic x emotion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="gen">
