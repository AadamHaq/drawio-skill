        <mxCell id="auth-s2" value="Cut New Prompt Arm&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;prompt_arms/pN+1.json (parent + changes)&lt;br/&gt;sections/pN+1/ composable system prompt&lt;/font&gt;"
