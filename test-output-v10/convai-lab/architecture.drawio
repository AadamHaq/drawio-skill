        <mxCell id="run-s1" value="Boot Realtime Service&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;convai/services/realtime (port 8001)&lt;br/&gt;EXPERIMENTAL_ENV + SYSTEM_PROMPT_CONFIG&lt;/font&gt;"
