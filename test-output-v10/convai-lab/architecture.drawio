<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="ac.draw.io">
  <diagram id="overview" name="Pipeline Overview">
    <mxGraphModel pageWidth="910" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== INPUT NODES: Author inputs (Row 0, y=30) ===== -->
        <mxCell id="in-envs" value="Tool Environments&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;environments/e2–e16&lt;br/&gt;tools + logic + manifest per arm&lt;/font&gt;"
          style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;fontStyle=1;fontSize=11;whiteSpace=wrap;"
          vertex="1" parent="1">
          <mxGeometry x="130" y="30" width="200" height="58" as="geometry" />
        </mxCell>

        <mxCell id="in-prompts" value="Prompt Arms&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;prompt_arms/p0–p12&lt;br/&gt;sections/ composable parts&lt;/font&gt;"
