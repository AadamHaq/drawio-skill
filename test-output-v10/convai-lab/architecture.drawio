        <mxCell id="run-s2" value="Invoke ceval simulate&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;sim model + judge model (vLLM local default)&lt;br/&gt;--max-turns 3 / --suite full / --batch-size 4&lt;/font&gt;"
