        </mxCell>

        <mxCell id="auth-s1" value="Cut New Environment&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cp parent → eN+1 / edit tools.py, logic.py&lt;br/&gt;stdlib-only pure functions, frozen snapshot&lt;/font&gt;"
