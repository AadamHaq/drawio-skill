        <!-- Step 1: Combo Grid -->
        <mxCell id="gs1" value="&lt;b&gt;1. Combo Grid&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;combos.py — dialect × block_type × topic × emotion × typing_style&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;"
