<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="ac.draw.io">
  <diagram id="page-0" name="Architecture Overview">
    <mxGraphModel pageWidth="1250" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══════ CONFIG LAYER (L0) ═══════ -->
        <mxCell id="L0" value="Config Layer&lt;br/&gt;&lt;font style='font-size:9px'&gt;generation_plan_ric_v9.yaml — selects environment, models, taxonomy&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=52;"
          vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="1150" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cfg" value="&lt;b&gt;generation_plan_ric_v9.yaml&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;environment: convai_spending_insights | models: deepseek-v4-flash&lt;br/&gt;threshold≥8 | batch=50 | block+assemble pipeline&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;"
          vertex="1" parent="L0">
          <mxGeometry x="305" y="58" width="540" height="46" as="geometry" />
        </mxCell>

        <!-- ═══════ PIPELINE LAYER (L1) ═══════ -->
        <mxCell id="L1" value="Pipeline Layer"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=36;"
          vertex="1" parent="1">
          <mxGeometry x="30" y="190" width="1150" height="240" as="geometry" />
        </mxCell>

        <!-- Pipeline items as root-level siblings (receive edges from config) -->
        <mxCell id="gen" value="&lt;b&gt;Generator&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;run_generation.py → multi_turn_gen.py&lt;br/&gt;combo grid (dialect×type×topic×emotion)&lt;br/&gt;query+answer LLM → blocks (2-3 followups)&lt;br/&gt;ToolBehavior dispatch: EXE / SYNTH / DET&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="60" y="252" width="310" height="100" as="geometry" />
        </mxCell>

        <mxCell id="val" value="&lt;b&gt;Validator&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;scorer.py → run_annotation.py&lt;br/&gt;LLM judge (deepseek-v4-flash, temp=0.1)&lt;br/&gt;mean≥8 pass, single-metric≥5 hard-fail&lt;br/&gt;tone insight gate (mean≥5, floor≥2)&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="440" y="252" width="290" height="100" as="geometry" />
        </mxCell>

        <mxCell id="pp" value="&lt;b&gt;Post-Processing&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;assemble_blocks.py → split.py → rebalance.py&lt;br/&gt;stitch passing blocks → multi-turn convos&lt;br/&gt;transition weights (tool:0.45, nlr:0.45, guard:0.10)&lt;br/&gt;train/val/eval split + category rebalance&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="800" y="252" width="310" height="100" as="geometry" />
        </mxCell>

        <!-- Fixer (inside pipeline band, below gen and val) -->
        <mxCell id="fixer" value="&lt;b&gt;Fixer&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;run_fix.py — LLM rewrite&lt;br/&gt;failed turns, re-annotate&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;verticalAlign=middle;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="460" y="372" width="200" height="48" as="geometry" />
        </mxCell>

        <!-- ═══════ ENVIRONMENT LAYER (L2) ═══════ -->
        <mxCell id="L2" value="Environment Layer&lt;br/&gt;&lt;font style='font-size:9px'&gt;environments/convai_spending_insights/ — pluggable domain module (ABC in base.py)&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef5f5;strokeColor=#b85450;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=52;dashed=1;dashPattern=8 4;"
          vertex="1" parent="1">
          <mxGeometry x="30" y="505" width="1150" height="160" as="geometry" />
        </mxCell>

        <!-- Environment items as root-level siblings -->
        <mxCell id="env-tools" value="&lt;b&gt;ToolSpec Registry&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;get_tools() → list[ToolSpec]&lt;br/&gt;behaviors: EXECUTE, SYNTHESIZE,&lt;br/&gt;DETERMINISTIC, TERMINAL&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="60" y="570" width="230" height="80" as="geometry" />
        </mxCell>

        <mxCell id="env-exec" value="&lt;b&gt;ConciergeDBExecutor&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;executor.py — PostgreSQL queries&lt;br/&gt;visualise_data: real DB → chart data&lt;br/&gt;persona-DB mode (persona-*.db)&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="330" y="570" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="env-guard" value="&lt;b&gt;Guardrailing&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;guardrailing/run_generation.py&lt;br/&gt;tag taxonomy + signposting&lt;br/&gt;corpus/LLM adversarial blocks&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="610" y="570" width="230" height="80" as="geometry" />
        </mxCell>

        <mxCell id="env-val" value="&lt;b&gt;Domain Validation&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;validator.py — validate_tool_call()&lt;br/&gt;structural check (categories, dates)&lt;br/&gt;rubric: validation_rubric_blocks.yaml&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="880" y="570" width="250" height="80" as="geometry" />
