        </mxCell>

        <!-- Step 5: Tool Result + Response -->
        <mxCell id="gs5" value="&lt;b&gt;5. Tool Result + Response&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;turn_gen.py — format tool_result, generate narration (≤60 words, British English)&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;"
          vertex="1" parent="gen-sl">
          <mxGeometry x="18" y="376" width="484" height="58" as="geometry" />
        </mxCell>

        <!-- Sequential edges within swimlane -->
