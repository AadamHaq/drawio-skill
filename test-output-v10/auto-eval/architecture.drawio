  <diagram id="page-1" name="Generator Drill-Down">
    <mxGraphModel pageWidth="960" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══════ GENERATOR SWIMLANE ═══════ -->
        <mxCell id="gen-sl" value="Generator&lt;br/&gt;&lt;font style='font-size:9px'&gt;run_generation.py → multi_turn_gen.py&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=12;swimlane;startSize=52;"
          vertex="1" parent="1">
          <mxGeometry x="175" y="30" width="520" height="460" as="geometry" />
