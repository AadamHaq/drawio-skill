          <mxGeometry x="18" y="218" width="484" height="48" as="geometry" />
        </mxCell>

        <!-- Step 4: Tool Behavior Dispatch -->
        <mxCell id="gs4" value="&lt;b&gt;4. Tool Behavior Dispatch&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;turn_gen.py — EXECUTE→env | SYNTHESIZE→LLM | DETERMINISTIC→env | TERMINAL→stop&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;"
