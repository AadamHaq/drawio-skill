          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;"
          vertex="1" parent="gen-sl">
          <mxGeometry x="18" y="148" width="484" height="48" as="geometry" />
        </mxCell>

        <!-- Step 3: Answer Decision -->
        <mxCell id="gs3" value="&lt;b&gt;3. Answer Decision&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;answer model (deepseek-v4-flash, temp=0.3, tool_choice=auto) → tool_call or NLR&lt;/font&gt;"
