        <mxCell id="dd-output" value="&lt;b&gt;output/raw/&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;multi_turn.json&lt;br/&gt;(block pool)&lt;/font&gt;"
