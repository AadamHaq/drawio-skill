        <mxCell id="vs6" value="Stream to Triton TTS&lt;br/&gt;(Chatterbox synth)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="voice-sl">
