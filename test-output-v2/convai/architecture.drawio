        <mxCell id="vs5" value="Run output guardrails&lt;br/&gt;(content safety)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="voice-sl">
          <mxGeometry x="18" y="397" width="264" height="58" as="geometry" />
