        <mxCell id="d-s1" value="1. Combo Grid&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;combos.py: dialect × block_type × topic&lt;br/&gt;× emotion × typing_style (Cartesian)&lt;br/&gt;batch_size=50, samples_per_combo=1&lt;/font&gt;" vertex="1" parent="d-gen"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;">
