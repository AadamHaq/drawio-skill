        <mxCell id="d-s2" value="2. Query Generation&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;turn_gen.py → deepseek-v4-flash&lt;br/&gt;temp=0.7, max_tokens=8192&lt;br/&gt;generates realistic user messages&lt;/font&gt;" vertex="1" parent="d-gen"
