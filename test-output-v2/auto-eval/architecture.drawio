<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="ac.draw.io">
  <diagram id="overview" name="Architecture Overview">
    <mxGraphModel pageWidth="870" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══ Layer 0: Config ═══ -->
        <mxCell id="L0" value="Config" vertex="1" parent="1"
          style="swimlane;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;html=1;rounded=1;">
          <mxGeometry x="30" y="30" width="810" height="80" as="geometry" />
