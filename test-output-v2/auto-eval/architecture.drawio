        <mxCell id="cfg" value="generation_plan_*.yaml&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;environment + models + taxonomy + pipeline stages&lt;br/&gt;drives all modules via single YAML per experiment&lt;/font&gt;" vertex="1" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=11;">
          <mxGeometry x="250" y="50" width="330" height="50" as="geometry" />
        </mxCell>

        <!-- ═══ Layer 1: Pipeline ═══ -->
