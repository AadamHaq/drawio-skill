        <!-- STT service (aligned with vs3, y = 40+248+10 = 298 absolute) -->
        <mxCell id="ext-stt" value="STT&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Triton (Nemotron)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="292" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- LLM service (aligned with vs5, y = 40+424+10 = 474 absolute) -->
        <mxCell id="ext-llm" value="LLM&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;vLLM (Qwen/Gemma)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="468" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- TTS service (aligned with vs6, y = 40+512+10 = 562 absolute) -->
        <mxCell id="ext-tts" value="TTS&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Triton (Chatterbox)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="556" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- ==================== STEP → EXTERNAL EDGES (horizontal) ==================== -->

        <!-- LiveKit → vs1 (Audio In): horizontal from right -->
        <mxCell id="vex1" value="audio in" edge="1" source="ext-livekit" target="vs1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;dashPattern=12 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- vs3 (STT Transcribe) → STT: horizontal -->
        <mxCell id="vex2" value="gRPC audio" edge="1" source="vs3" target="ext-stt" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- vs5 (LLM Generate) → LLM: horizontal -->
        <mxCell id="vex3" value="completions" edge="1" source="vs5" target="ext-llm" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- vs6 (TTS Synthesise) → TTS: horizontal -->
        <mxCell id="vex4" value="gRPC synth" edge="1" source="vs6" target="ext-tts" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- vs7 (Audio Out) → LiveKit: RETURN edge UP on LEFT side (x=210, well left of swimlane x=270) -->
        <mxCell id="vex5" value="audio out" edge="1" source="vs7" target="ext-livekit" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;dashPattern=12 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="210" y="669" />
              <mxPoint x="210" y="100" />
              <mxPoint x="685" y="100" />
