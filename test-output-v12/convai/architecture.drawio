        <mxCell id="ext-livekit" value="LiveKit&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;WebRTC SFU :7880&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="116" width="170" height="50" as="geometry" />
